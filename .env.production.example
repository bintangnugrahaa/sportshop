# ==============================================================================
# SportShop Production Environment Variables Template
# Copy this file to .env.production and provide real values before deploying.
# WARNING: NEVER commit .env or secrets to version control!
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=sportshop_admin
POSTGRES_PASSWORD=replace_with_strong_database_password_min_24_chars
POSTGRES_DB=sportshop_prod

# Redis Cache Security
REDIS_PASSWORD=replace_with_strong_random_redis_password_min_32_chars

# ASP.NET Core JWT Authentication
# Secret key MUST be at least 32 characters long, preferably 64 hex/base64 characters
Jwt__Key=replace_with_cryptographically_secure_jwt_key_at_least_64_chars_long!
Jwt__Issuer=SportShopApi
Jwt__Audience=SportShopClient

# Midtrans Payment Gateway (Production Mode)
Midtrans__ServerKey=Mid-server-replace_with_production_server_key
Midtrans__ClientKey=Mid-client-replace_with_production_client_key
Midtrans__IsProduction=true

# CORS & Domain Settings
Cors__Origins=https://sportshop.id,https://www.sportshop.id
PORT_HTTP=80

# Logging & Monitoring (Seq)
# Generate password hash via: echo '<password>' | docker run --rm -i datalust/seq:latest hash
SEQ_ADMIN_PASSWORD_HASH=

# Production SMTP Email Delivery
Smtp__Host=smtp.sendgrid.net
Smtp__Port=587
Smtp__User=apikey
Smtp__Password=replace_with_production_smtp_api_key
Smtp__From=no-reply@sportshop.id

# Initial Admin Account Seed
SEED_ADMIN_EMAIL=admin@sportshop.id
SEED_ADMIN_PASSWORD=replace_with_secure_admin_password_min_12_chars!

# Business Rules
Order__ExpiryHours=24
