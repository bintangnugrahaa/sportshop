# Database PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sportshop
ConnectionStrings__Default=Host=db;Port=5432;Database=sportshop;Username=postgres;Password=postgres

# Redis Cache
Redis__ConnectionString=redis:6379

# JWT Authentication
Jwt__Key=super-secret-key-that-is-at-least-32-characters-long!
Jwt__Issuer=SportShopApi
Jwt__Audience=SportShopClient

# Midtrans Payment Gateway (Sandbox default)
Midtrans__ServerKey=SB-Mid-server-placeholder
Midtrans__ClientKey=SB-Mid-client-placeholder
Midtrans__IsProduction=false

# CORS & Frontend URLs
Cors__Origins=http://localhost:5173,http://localhost:80

# Logging & Observability (Seq & OpenTelemetry)
Seq__ServerUrl=http://seq:5341
Otel__OtlpEndpoint=http://seq:5341/ingest/otlp

# SMTP (Mailpit for dev)
Smtp__Host=mailpit
Smtp__Port=1025
Smtp__User=
Smtp__Password=
Smtp__From=no-reply@sportshop.dev

# Initial Admin Seeder
SEED_ADMIN_EMAIL=admin@sportshop.dev
SEED_ADMIN_PASSWORD=Admin123!

# Business rules
Order__ExpiryHours=24
